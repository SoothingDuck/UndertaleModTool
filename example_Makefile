UNDERTALEMODTOOLDIR = $(HOME)/dev/gamemaker/UndertaleModTool
UNDERTALEMODCLI = $(UNDERTALEMODTOOLDIR)/UndertaleModCli/bin/Release/net10.0/publish/UndertaleModCli
SCRIPTDIR = $(UNDERTALEMODTOOLDIR)/UndertaleModTool/Scripts/GMS2-Export

.PHONY: sprites font rooms objects

all: font sprites

sprites:
	$(UNDERTALEMODCLI) load data.win -s $(SCRIPTDIR)/ExportSpritesTowerDefense.csx

font:
	$(UNDERTALEMODCLI) load data.win -s $(SCRIPTDIR)/ExportFontDataTowerDefense.csx

room:
	$(UNDERTALEMODCLI) load data.win -s $(SCRIPTDIR)/ExportRoomsTowerDefense.csx

objects:
	$(UNDERTALEMODCLI) load data.win -s $(SCRIPTDIR)/ExportGameObjectsTowerDefense.csx
